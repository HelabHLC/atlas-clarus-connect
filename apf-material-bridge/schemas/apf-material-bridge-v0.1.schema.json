{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-clarus.example/schemas/apf-material-bridge-v0.1.schema.json",
  "title": "ATLAS Clarus APF Material Bridge v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "document_status", "conformance_level", "identity", "assets", "material_selector", "identity_binding", "measurement_provenance", "render_results", "physical_comparison", "qc_conclusion"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "document_id": {"type": "string", "minLength": 1},
    "document_status": {"enum": ["REVIEW_DRAFT", "ACTIVE", "SUPERSEDED", "INVALID"]},
    "conformance_level": {"enum": ["APF-MATERIAL-REFERENCE", "APF-MATERIAL-RENDERED", "APF-MATERIAL-MEASURED", "APF-MATERIAL-QC"]},
    "identity": {"$ref": "#/$defs/identity"},
    "assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asset"}},
    "material_selector": {"$ref": "#/$defs/selector"},
    "identity_binding": {"$ref": "#/$defs/binding"},
    "geometry": {"$ref": "#/$defs/geometry"},
    "measurement_provenance": {"$ref": "#/$defs/provenance"},
    "render_results": {"type": "array", "items": {"$ref": "#/$defs/render"}},
    "physical_comparison": {"$ref": "#/$defs/physical"},
    "qc_conclusion": {"$ref": "#/$defs/qc"},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["identity_id", "atlas_row", "reference_code", "master_sha256", "status"],
      "properties": {
        "identity_id": {"type": "string", "minLength": 1}, "atlas_row": {"type": "integer", "minimum": 0},
        "reference_code": {"type": "string"}, "master_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["REFERENCE_BOUND", "VERIFIED", "INVALID"]}
      }
    },
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["asset_id", "role", "uri", "sha256", "media_type", "format", "file_extension", "media_type_status", "integrity_status"],
      "properties": {
        "asset_id": {"type": "string"}, "role": {"enum": ["APPEARANCE_MATERIAL", "RENDER_RESULT", "MEASUREMENT_EVIDENCE", "QC_EVIDENCE"]},
        "uri": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}, "media_type": {"type": "string"},
        "format": {"enum": ["MATERIALX", "OPENPBR_JSON", "GLTF", "PBR_TEXTURE_SET", "AXF_ADAPTER", "OTHER", "PNG", "JPEG", "WEBP"]},
        "file_extension": {"type": "string"}, "media_type_status": {"enum": ["REGISTERED", "UNREGISTERED_FALLBACK", "IMPLEMENTATION_DEFINED"]},
        "integrity_status": {"enum": ["SOURCE_DECLARED", "VERIFIED", "INVALID"]}
      }
    },
    "selector": {
      "type": "object", "additionalProperties": false,
      "required": ["selector_id", "asset_ref", "selector_type", "value", "resolution_status"],
      "properties": {
        "selector_id": {"type": "string"}, "asset_ref": {"type": "string"},
        "selector_type": {"enum": ["DISPLAY_NAME", "MATERIAL_ID", "REPRESENTATION_ID", "IMPLEMENTATION_DEFINED"]},
        "value": {"type": "string"}, "resolution_status": {"enum": ["RESOLVED", "SOURCE_DECLARED", "UNRESOLVED", "INVALID"]},
        "representation_model": {"enum": ["OPENPBR", "METALLIC_ROUGHNESS", "SPECULAR_GLOSSINESS", "SVBRDF", "BTF", "OTHER", "UNKNOWN"]}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["binding_id", "identity_ref", "asset_ref", "selector_ref", "status"],
      "properties": {
        "binding_id": {"type": "string"}, "identity_ref": {"type": "string"}, "asset_ref": {"type": "string"}, "selector_ref": {"type": "string"},
        "status": {"enum": ["REFERENCE_BOUND", "VERIFIED", "INVALID"]}
      }
    },
    "geometry": {
      "type": "object", "additionalProperties": false,
      "required": ["geometry_id", "template", "source_type", "status", "implementation", "zone_ids"],
      "properties": {
        "geometry_id": {"type": "string", "minLength": 1},
        "template": {"type": "string", "minLength": 1},
        "source_type": {"enum": ["BUILT_IN", "EXTERNAL_ASSET"]},
        "status": {"enum": ["BUILT_IN", "SOURCE_DECLARED", "VERIFIED", "INVALID"]},
        "implementation": {"type": "string", "minLength": 1},
        "zone_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "evidence_refs"],
      "properties": {
        "status": {"enum": ["MEASURED", "SOURCE_DECLARED", "NOT_MEASURED", "UNKNOWN"]},
        "organization": {"type": "string"}, "device": {"type": "string"}, "method": {"type": "string"},
        "measured_at": {"type": "string", "format": "date-time"}, "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "render": {
      "type": "object", "additionalProperties": false,
      "required": ["render_id", "binding_ref", "renderer", "renderer_version", "scene_id", "illumination", "camera", "output_asset_ref", "status"],
      "properties": {
        "render_id": {"type": "string"}, "binding_ref": {"type": "string"}, "renderer": {"type": "string"}, "renderer_version": {"type": "string"},
        "scene_id": {"type": "string"}, "illumination": {"type": "string"}, "camera": {"type": "string"}, "output_asset_ref": {"type": "string"},
        "status": {"enum": ["CALCULATED", "SIMULATED"]}
      }
    },
    "physical": {
      "type": "object", "additionalProperties": false, "required": ["status", "evidence_refs"],
      "properties": {"status": {"enum": ["NOT_MEASURED", "MEASURED", "INVALID"]}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "method": {"type": "string"}}
    },
    "qc": {
      "type": "object", "additionalProperties": false, "required": ["status", "evidence_refs"],
      "properties": {"status": {"enum": ["NOT_MEASURED", "VERIFIED", "INVALID"]}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "decision": {"enum": ["PASS", "FAIL", "NOT_EVALUATED"]}}
    }
  }
}
