diff --git a/frontend/tools/testing/clarus/browser.cjs b/frontend/tools/testing/clarus/browser.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..b132ef408c028fa26d14a2573d12f5f0d25a8085
--- /dev/null
+++ b/frontend/tools/testing/clarus/browser.cjs
@@ -0,0 +1,189 @@
+/* Starts an isolated test host on port 4179 using the actual MoodboardWorkspace. */
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const { chromium } = require(
+  process.env.CLARUS_PLAYWRIGHT_MODULE || "playwright",
+);
+const root = path.resolve(__dirname, "../../..");
+const fixture = path.join(
+  root,
+  "libs/components/moodboard/src/lib/clarus/two-greens.clarus.json",
+);
+const output =
+  process.env.CLARUS_RESULTS_DIR ||
+  path.join(root, "test-output/clarus-browser");
+const checks = [];
+
+(async () => {
+  fs.mkdirSync(output, { recursive: true });
+  const { createServer } = await import("vite");
+  const server = await createServer({
+    configFile: path.join(__dirname, "vite.config.ts"),
+    logLevel: "error",
+  });
+  await server.listen();
+  const browser = await chromium.launch({ headless: true }).catch(async (error) => {
+    await server.close();
+    throw error;
+  });
+  const page = await browser.newPage({
+    viewport: { width: 1920, height: 1080 },
+  });
+  const pageErrors = [];
+  page.on("pageerror", (error) => pageErrors.push(error.message));
+  await page.route("**/*", (route) => {
+    if (new URL(route.request().url()).hostname === "127.0.0.1")
+      return route.continue();
+    return route.abort();
+  });
+  try {
+    await page.goto("http://127.0.0.1:4179");
+    const button = page.getByRole("button", {
+      name: "Import ATLAS Clarus palette",
+      exact: true,
+    });
+    await button.waitFor();
+    const chooserPromise = page.waitForEvent("filechooser");
+    await button.click();
+    await (await chooserPromise).setFiles(fixture);
+    await page
+      .getByText("Imported 2 original colors with ATLAS references", {
+        exact: true,
+      })
+      .waitFor();
+    checks.push(
+      "Native toolbar opens file chooser and imports the Clarus JSON",
+    );
+    let state = await savedState(page);
+    let colors = Object.values(state.boards[state.activeBoardId].items);
+    assert.deepEqual(
+      colors.map((color) => color.color),
+      ["#3D7B19", "#3C7B19"],
+    );
+    assert.equal(new Set(colors.map((color) => color.id)).size, 2);
+    assert.deepEqual(
+      colors.map((color) => color.atlasClarus.source_assignment.atlas_row_id),
+      [4966, 4966],
+    );
+    checks.push(
+      "Two original greens have distinct native item IDs and the same reference",
+    );
+    await page.screenshot({
+      path: path.join(output, "01-native-moodboard.png"),
+    });
+    await page.getByText("#3D7B19", { exact: true }).dblclick();
+    await page
+      .getByRole("region", { name: "ATLAS Clarus reference" })
+      .waitFor();
+    await page.getByText("H130_L045_C055", { exact: true }).waitFor();
+    await page
+      .getByText("#3D7B19 · RGB 61, 123, 25", { exact: true })
+      .waitFor();
+    await page.getByText("#37791A", { exact: true }).waitFor();
+    checks.push(
+      "Real ItemInspector displays original RGB and reference separately",
+    );
+    // Let the existing modal fade finish before capturing its actual contrast.
+    await page.waitForTimeout(350);
+    await page.screenshot({
+      path: path.join(output, "02-native-inspector.png"),
+    });
+    await page.reload();
+    await button.waitFor();
+    state = await savedState(page);
+    colors = Object.values(state.boards[state.activeBoardId].items);
+    assert.deepEqual(
+      colors.map((color) => color.color),
+      ["#3D7B19", "#3C7B19"],
+    );
+    await page.getByText("#3C7B19", { exact: true }).dblclick();
+    await page
+      .getByText("#3C7B19 · RGB 60, 123, 25", { exact: true })
+      .waitFor();
+    await page.getByText("H130_L045_C055", { exact: true }).waitFor();
+    checks.push(
+      "Browser reload restores both colors and their full annotations",
+    );
+    await page.keyboard.press("Escape");
+    await page.getByRole("dialog").waitFor({ state: "hidden" });
+    const beforeInvalid = JSON.stringify(await savedState(page));
+    const invalid = JSON.parse(fs.readFileSync(fixture, "utf8"));
+    invalid.source_assignments[1].master_sha256 = "0".repeat(64);
+    await page.getByLabel("ATLAS Clarus palette JSON").setInputFiles({
+      name: "invalid.json",
+      mimeType: "application/json",
+      buffer: Buffer.from(JSON.stringify(invalid)),
+    });
+    await page
+      .getByText("Source assignment has a conflicting reference identity.", {
+        exact: true,
+      })
+      .waitFor();
+    assert.equal(JSON.stringify(await savedState(page)), beforeInvalid);
+    checks.push(
+      "Invalid second assignment leaves the existing board unchanged",
+    );
+    await page.getByLabel("ATLAS Clarus palette JSON").setInputFiles(fixture);
+    await page
+      .getByText("Imported 2 original colors with ATLAS references", {
+        exact: true,
+      })
+      .waitFor();
+    state = await savedState(page);
+    assert.equal(
+      Object.keys(state.boards[state.activeBoardId].items).length,
+      4,
+    );
+    checks.push("The same file can be selected again after rejection");
+    assert.deepEqual(pageErrors, []);
+    checks.push("No JavaScript page errors");
+    fs.writeFileSync(
+      path.join(output, "browser-results.json"),
+      JSON.stringify(
+        {
+          status: "PASS",
+          browser: await browser.version(),
+          checks,
+          scope:
+            "Real ArtCraft MoodboardWorkspace in an isolated browser host; native Tauri runtime not exercised.",
+        },
+        null,
+        2,
+      ),
+    );
+    console.log(JSON.stringify({ status: "PASS", checks }, null, 2));
+  } catch (error) {
+    await page.screenshot({ path: path.join(output, "failure.png") });
+    fs.writeFileSync(
+      path.join(output, "failure.txt"),
+      await page.locator("body").innerText(),
+    );
+    fs.writeFileSync(
+      path.join(output, "browser-results.json"),
+      JSON.stringify(
+        {
+          status: "FAIL",
+          checks,
+          error: String(error),
+          pageErrors,
+        },
+        null,
+        2,
+      ),
+    );
+    throw error;
+  } finally {
+    await browser.close();
+    await server.close();
+  }
+})().catch((error) => {
+  console.error(error);
+  process.exitCode = 1;
+});
+
+async function savedState(page) {
+  return page.evaluate(
+    () => JSON.parse(localStorage.getItem("artcraft_moodboard_library")).state,
+  );
+}
