+import { webcrypto } from "node:crypto";
+import { cleanup, render, screen } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { ClarusDetails } from "./ClarusDetails";
+import { prepareClarusImport } from "./importPalette";
+import sourceText from "./two-greens.clarus.json?raw";
+import type { BoardColorItem } from "../boards/boardTypes";
+
+beforeEach(() => vi.stubGlobal("crypto", webcrypto));
+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+});
+
+describe("ATLAS details alongside the original swatch", () => {
+  it("shows original and reference separately with qualified provenance", async () => {
+    const item = await greenItem();
+    render(<ClarusDetails item={item} />);
+    await screen.findByText("H130_L045_C055");
+    expect(screen.getByText("#3D7B19 · RGB 61, 123, 25")).toBeTruthy();
+    expect(screen.getByText("#37791A")).toBeTruthy();
+    expect(
+      screen.getByText(/Image origin and signature are unverified/),
+    ).toBeTruthy();
+    expect(screen.getByText("4966 (zero-based)")).toBeTruthy();
+  });
+  it("identifies the stored mapping as historical after the design color changes", async () => {
+    const item = await greenItem();
+    render(<ClarusDetails item={{ ...item, color: "#FFFFFF" }} />);
+    expect(await screen.findByText(/The swatch has changed/)).toBeTruthy();
+    expect(screen.getByText("#3D7B19 · RGB 61, 123, 25")).toBeTruthy();
+  });
+  it("does not show a corrupted reference as validated", async () => {
+    const item = await greenItem();
+    item.atlasClarus!.source_assignment.reference = "H000_L000_C000";
+    render(<ClarusDetails item={item} />);
+    await screen.findByText(/could not be validated/);
+    expect(screen.queryByText("H000_L000_C000")).toBeNull();
+  });
+  it("adds nothing to legacy swatches", () => {
+    const { container } = render(
+      <ClarusDetails
+        item={{
+          id: "legacy",
+          kind: "color",
+          color: "#123456",
+          sectionId: null,
+          createdAt: 1,
+          tags: [],
+          rating: 0,
+          aspect: 1,
+        }}
+      />,
+    );
+    expect(container.textContent).toBe("");
+  });
+});
+
+async function greenItem(): Promise<BoardColorItem> {
+  const [entry] = await prepareClarusImport(
+    new TextEncoder().encode(sourceText),
+    "greens.json",
+  );
+  return {
+    id: "green",
+    kind: "color",
+    sectionId: null,
+    createdAt: 1,
+    tags: [],
+    rating: 0,
+    aspect: 1,
+    ...entry,
+  };
+}
