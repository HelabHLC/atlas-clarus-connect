+// Development-only host for the actual ArtCraft moodboard components.
+// No account, upload, generation service or remote persistence is connected.
+import React from "react";
+import { createRoot } from "react-dom/client";
+import { Toaster } from "react-hot-toast";
+import { MoodboardWorkspace } from "../../../libs/components/moodboard/src/lib/MoodboardWorkspace";
+import "../../../apps/artcraft/app/src/styles/base.css";
+import "../../../apps/artcraft/app/src/styles/tailwind.css";
+
+createRoot(document.getElementById("root")!).render(
+  <React.StrictMode>
+    <MoodboardWorkspace adapter={{ sendToGeneration: () => undefined }} />
+    <Toaster position="bottom-right" />
+  </React.StrictMode>,
+);
