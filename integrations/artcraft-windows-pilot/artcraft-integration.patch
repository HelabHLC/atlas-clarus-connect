+import type { Board, BoardColorItem } from "../boards/boardTypes";
+import {
+  CLARUS_MASTER_SHA256,
+  validateClarusAnnotation,
+  validateClarusPalette,
+} from "./importPalette";
+import type {
+  ClarusAnnotation,
+  ClarusPalette,
+  ClarusReference,
+  ClarusSourceAssignment,
+} from "./types";
+
+const WORKFLOW = "ATLAS Clarus v3.4.0";
+
+export interface ClarusExportResult {
+  palette: ClarusPalette;
+  text: string;
+  filename: string;
+  sourceCount: number;
+}
+
+export async function createClarusExport(
+  board: Board,
+): Promise<ClarusExportResult> {
+  const annotations: ClarusAnnotation[] = [];
+  for (const id of board.itemOrder) {
+    const item = board.items[id] as BoardColorItem | undefined;
+    if (item?.kind !== "color" || !item.atlasClarus) continue;
+    annotations.push(await validateClarusAnnotation(item.atlasClarus));
+  }
+  if (!annotations.length) {
+    throw new Error(
+      "This board has no imported ATLAS Clarus original colors to export.",
+    );
+  }
+
+  const references = new Map<number, ClarusReference>();
+  const referenceFingerprints = new Map<number, string>();
+  const sourceAssignments: ClarusSourceAssignment[] = [];
+  for (const annotation of annotations) {
+    const reference = structuredClone(annotation.reference_record);
+    const row = reference.atlas_row_id;
+    const fingerprint = canonicalJson(reference);
+    const previous = referenceFingerprints.get(row);
+    if (previous !== undefined && previous !== fingerprint) {
+      throw new Error(
+        "Conflicting saved reference records for ATLAS row " +
+          row +
+          ". Export those imports separately.",
+      );
+    }
+    if (!references.has(row)) {
+      references.set(row, reference);
+      referenceFingerprints.set(row, fingerprint);
+    }
+    sourceAssignments.push(structuredClone(annotation.source_assignment));
+  }
+
+  const documentIds = new Set(
+    annotations.map((annotation) => annotation.import.document_id),
+  );
+  const originalName =
+    documentIds.size === 1 ? annotations[0].import.palette_name?.trim() : "";
+  const paletteName =
+    originalName || board.name?.trim() || "ArtCraft ATLAS Clarus export";
+
+  const palette: ClarusPalette = {
+    format: "ATLAS_CLARUS_PALETTE",
+    version: "1.2",
+    palette_name: paletteName,
+    workflow: WORKFLOW,
+    master_sha256: CLARUS_MASTER_SHA256,
+    row_id_base: 0,
+    freeze_status: "FROZEN",
+    measured_qc_status: "NOT_MEASURED",
+    references: [...references.values()],
+    source_assignments: sourceAssignments,
+  };
+
+  // Re-run the same strict validator used on import. Export never remaps,
+  // substitutes the current design swatch, or upgrades an unsigned record.
+  await validateClarusPalette(palette);
+
+  return {
+    palette,
+    text: JSON.stringify(palette, null, 2) + "\n",
+    filename: safeFilename(paletteName) + ".clarus.json",
+    sourceCount: sourceAssignments.length,
+  };
+}
+
+function safeFilename(name: string) {
+  const cleaned = name
+    .replace(/[<>:"/\\|?*\u0000-\u001F]/g, "-")
+    .replace(/\s+/g, " ")
+    .replace(/[. ]+$/g, "")
+    .trim()
+    .slice(0, 96);
+  return cleaned || "artcraft-atlas-clarus";
+}
+
+function canonicalJson(value: unknown): string {
+  if (Array.isArray(value)) return "[" + value.map(canonicalJson).join(",") + "]";
+  if (value && typeof value === "object") {
+    const object = value as Record<string, unknown>;
+    return (
+      "{" +
+      Object.keys(object)
+        .sort()
+        .map((key) => JSON.stringify(key) + ":" + canonicalJson(object[key]))
+        .join(",") +
+      "}"
+    );
+  }
+  return JSON.stringify(value);
+}
