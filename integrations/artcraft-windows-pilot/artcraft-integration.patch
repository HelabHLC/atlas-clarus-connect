+import { webcrypto } from "node:crypto";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import sourceText from "./two-greens.clarus.json?raw";
+import { prepareClarusImport, validateClarusAnnotation } from "./importPalette";
+import { useBoardLibraryStore } from "../boards/BoardLibraryStore";
+import {
+  deserializeMoodboardDocument,
+  EMPTY_CANVAS_DOCUMENT,
+  serializeMoodboardDocument,
+} from "../persistence/documents";
+import type { BoardColorItem } from "../boards/boardTypes";
+import type { ClarusPalette } from "./types";
+
+const bytes = (value: string) => new TextEncoder().encode(value);
+const fixture = (): ClarusPalette => JSON.parse(sourceText);
+const storageKey = "artcraft_moodboard_library";
+const sourceHash =
+  "17f0401a8669ba0123b5ac409d23aab5252150ba26bf47a95d7537c31df8a4b0";
+
+beforeEach(() => {
+  vi.stubGlobal("crypto", webcrypto);
+  localStorage.clear();
+  useBoardLibraryStore.setState({
+    boards: {},
+    boardOrder: [],
+    activeBoardId: null,
+    selectedItemIds: new Set(),
+  });
+});
+afterEach(() => {
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+});
+
+describe("Clarus import in the native ArtCraft board store", () => {
+  it("keeps two original greens and their full provenance under one reference", async () => {
+    const store = useBoardLibraryStore.getState();
+    const id = store.createBoard("Clarus");
+    const legacyId = store.addColorItem(id, "#123456");
+    expect(
+      await store.importClarusPalette(id, bytes(sourceText), "greens.json"),
+    ).toBe(2);
+    const board = useBoardLibraryStore.getState().boards[id];
+    const colors = board.itemOrder.map(
+      (key) => board.items[key] as BoardColorItem,
+    );
+    expect(colors.map((item) => item.color)).toEqual([
+      "#123456",
+      "#3D7B19",
+      "#3C7B19",
+    ]);
+    expect(board.items[legacyId]).not.toHaveProperty("atlasClarus");
+    expect(new Set(colors.map((item) => item.id)).size).toBe(3);
+    expect(colors[1].atlasClarus?.import.document_sha256).toBe(sourceHash);
+    expect(colors[1].atlasClarus?.import.document_id).toBe(
+      colors[2].atlasClarus?.import.document_id,
+    );
+    for (const [index, item] of colors.slice(1).entries()) {
+      const annotation = item.atlasClarus!;
+      expect(annotation.import.source_assignment_index).toBe(index);
+      expect(annotation.source_assignment).toEqual(
+        fixture().source_assignments[index],
+      );
+      expect(annotation.reference_record).toEqual(fixture().references[0]);
+      expect(annotation.source_assignment.reference).toBe("H130_L045_C055");
+      expect(annotation.source_assignment.atlas_row_id).toBe(4966);
+      expect(annotation.source_assignment.image.sha256).toBeNull();
+      expect(await validateClarusAnnotation(annotation)).toEqual(annotation);
+    }
+  });
+
+  it("round-trips through localStorage rehydration and ArtCraft's document serializer", async () => {
+    const store = useBoardLibraryStore.getState();
+    const id = store.createBoard("Clarus");
+    await store.importClarusPalette(id, bytes(sourceText), "greens.json");
+    const original = useBoardLibraryStore.getState().boards[id];
+    const saved = localStorage.getItem(storageKey)!;
+    useBoardLibraryStore.setState({
+      boards: {},
+      boardOrder: [],
+      activeBoardId: null,
+    });
+    localStorage.setItem(storageKey, saved);
+    await useBoardLibraryStore.persist.rehydrate();
+    expect(useBoardLibraryStore.getState().boards[id]).toEqual(original);
+    const document = serializeMoodboardDocument({
+      board: original,
+      canvas: EMPTY_CANVAS_DOCUMENT,
+    });
+    expect(
+      deserializeMoodboardDocument(JSON.stringify(document))?.board.items,
+    ).toEqual(original.items);
+  });
+
+  it("preserves extra provenance fields without interpreting them", async () => {
+    const palette = fixture();
+    palette.source_assignments[0].operator_note = {
+      instrument: null,
+      note: "synthetic",
+    };
+    const prepared = await prepareClarusImport(
+      bytes(JSON.stringify(palette)),
+      "extra.json",
+    );
+    expect(prepared[0].atlasClarus.source_assignment.operator_note).toEqual({
+      instrument: null,
+      note: "synthetic",
+    });
+  });
+
+  it("keeps repeated imports as separate occurrences", async () => {
+    const store = useBoardLibraryStore.getState();
+    const id = store.createBoard();
+    await store.importClarusPalette(id, bytes(sourceText), "greens.json");
+    await store.importClarusPalette(id, bytes(sourceText), "greens.json");
+    const items = Object.values(
+      useBoardLibraryStore.getState().boards[id].items,
+    ) as BoardColorItem[];
+    expect(items).toHaveLength(4);
+    expect(
+      new Set(items.map((item) => item.atlasClarus?.import.document_id)).size,
+    ).toBe(2);
+  });
+
+  it("rolls back completely on localStorage quota failure", async () => {
+    const store = useBoardLibraryStore.getState();
+    const id = store.createBoard();
+    store.addColorItem(id, "#ABCDEF");
+    const original = useBoardLibraryStore.getState().boards;
+    const saved = localStorage.getItem(storageKey);
+    vi.spyOn(Storage.prototype, "setItem").mockImplementation(() => {
+      throw new DOMException("Quota exceeded", "QuotaExceededError");
+    });
+    await expect(
+      store.importClarusPalette(id, bytes(sourceText), "greens.json"),
+    ).rejects.toThrow("could not save");
+    expect(useBoardLibraryStore.getState().boards).toBe(original);
+    expect(localStorage.getItem(storageKey)).toBe(saved);
+  });
+
+  it("does not apply to a different or deleted destination board", async () => {
+    const store = useBoardLibraryStore.getState();
+    const id = store.createBoard();
+    const pending = store.importClarusPalette(
+      id,
+      bytes(sourceText),
+      "greens.json",
+    );
+    const other = store.createBoard();
+    store.deleteBoard(id);
+    await expect(pending).rejects.toThrow("destination board changed");
+    expect(useBoardLibraryStore.getState().boards[other].itemOrder).toEqual([]);
+  });
+
+  it.each<[string, (palette: ClarusPalette) => void]>([
+    [
+      "master hash",
+      (p) => {
+        p.master_sha256 = "0".repeat(64);
+      },
+    ],
+    [
+      "source master hash",
+      (p) => {
+        p.source_assignments[1].master_sha256 = "0".repeat(64);
+      },
+    ],
+    [
+      "original HEX",
+      (p) => {
+        p.source_assignments[1].source_hex = "#3D7B19";
+      },
+    ],
+    [
+      "source RGB range",
+      (p) => {
+        p.source_assignments[1].source_rgb[0] = 256;
+      },
+    ],
+    [
+      "reference address",
+      (p) => {
+        p.references[0].reference = "H000_L000_C000";
+      },
+    ],
+    [
+      "reference row",
+      (p) => {
+        p.source_assignments[1].atlas_row_id = 4967;
+      },
+    ],
+    [
+      "duplicate reference",
+      (p) => {
+        p.references.push(p.references[0]);
+      },
+    ],
+    [
+      "distance",
+      (p) => {
+        p.source_assignments[1].distance_squared = 0;
+      },
+    ],
+    [
+      "image hash",
+      (p) => {
+        p.source_assignments[1].image.sha256 = "not-a-hash";
+      },
+    ],
+    [
+      "sample bounds",
+      (p) => {
+        p.source_assignments[1].sampling.bounds[0] = 999;
+      },
+    ],
+    [
+      "missing originals",
+      (p) => {
+        p.source_assignments = [];
+      },
+    ],
+    [
+      "too many originals",
+      (p) => {
+        p.source_assignments = Array(4097).fill(p.source_assignments[0]);
+      },
+    ],
+  ])(
+    "rejects invalid %s without partial board changes",
+    async (_label, mutate) => {
+      const store = useBoardLibraryStore.getState();
+      const id = store.createBoard();
+      store.addColorItem(id, "#ABCDEF");
+      const original = useBoardLibraryStore.getState().boards;
+      const saved = localStorage.getItem(storageKey);
+      const palette = fixture();
+      mutate(palette);
+      await expect(
+        store.importClarusPalette(
+          id,
+          bytes(JSON.stringify(palette)),
+          "invalid.json",
+        ),
+      ).rejects.toThrow();
+      expect(useBoardLibraryStore.getState().boards).toBe(original);
+      expect(localStorage.getItem(storageKey)).toBe(saved);
+    },
+  );
+
+  it("rejects malformed UTF-8, JSON, oversize files and excessive nesting", async () => {
+    await expect(
+      prepareClarusImport(new Uint8Array([255]), "bad.json"),
+    ).rejects.toThrow("UTF-8");
+    await expect(prepareClarusImport(bytes("{"), "bad.json")).rejects.toThrow(
+      "JSON",
+    );
+    await expect(
+      prepareClarusImport(new Uint8Array(16 * 1024 * 1024 + 1), "large.json"),
+    ).rejects.toThrow("16 MiB");
+    await expect(
+      prepareClarusImport(
+        bytes("[".repeat(66) + "0" + "]".repeat(66)),
+        "deep.json",
+      ),
+    ).rejects.toThrow("nesting");
+  });
+
+  it("accepts a UTF-8 BOM but hashes the received bytes including that BOM", async () => {
+    const prepared = await prepareClarusImport(
+      bytes("\uFEFF" + sourceText),
+      "bom.json",
+    );
+    expect(prepared[0].color).toBe("#3D7B19");
+    expect(prepared[0].atlasClarus.import.document_sha256).not.toBe(sourceHash);
+  });
+
+  it("detects a tampered annotation after loading a board document", async () => {
+    const [prepared] = await prepareClarusImport(
+      bytes(sourceText),
+      "greens.json",
+    );
+    prepared.atlasClarus.source_assignment.reference_hex = "#FFFFFF";
+    await expect(
+      validateClarusAnnotation(prepared.atlasClarus),
+    ).rejects.toThrow();
+  });
+});
diff --git a/frontend/libs/components/moodboard/src/lib/clarus/importPalette.ts b/frontend/libs/components/moodboard/src/lib/clarus/importPalette.ts
