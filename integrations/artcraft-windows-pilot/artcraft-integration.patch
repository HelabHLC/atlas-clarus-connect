+  source_assignment: ClarusSourceAssignment;
+  reference_record: ClarusReference;
+  reference_csv_sha256: string;
+}
+
+export type RGB = [number, number, number];
+
+export interface ClarusPalette {
+  format: "ATLAS_CLARUS_PALETTE";
+  version: "1.2";
+  palette_name?: string;
+  workflow: string;
+  master_sha256: string;
+  row_id_base: 0;
+  freeze_status: "FROZEN";
+  measured_qc_status: "NOT_MEASURED";
+  references: ClarusReference[];
+  source_assignments: ClarusSourceAssignment[];
+}
+
+export interface ClarusReference {
+  atlas_row_id: number;
+  reference: string;
+  master_rgb: RGB;
+  master_hex: string;
+  [field: string]: unknown;
+}
+
+export interface ClarusSourceAssignment {
+  schema_version: "1.0";
+  source_rgb: RGB;
+  source_hex: string;
+  color_space: "sRGB";
+  bits_per_channel: 8;
+  source_representation: "BROWSER_DECODED_SRGB";
+  atlas_row_id: number;
+  reference: string;
+  reference_rgb: RGB;
+  reference_hex: string;
+  master_sha256: string;
+  workflow: string;
+  metric: "RGB_SQUARED_DISTANCE";
+  distance_squared: number;
+  tie_break: "LOWER_ATLAS_ROW_ID";
+  signature_status: "NOT_SIGNED";
+  image: {
+    name: string;
+    width: number;
+    height: number;
+    sha256: string | null;
+    [field: string]: unknown;
+  };
+  sampling: {
+    mode: "PIXEL_RGB" | "AREA_MEAN_RGB";
+    requested_size: number;
+    centre: [number, number];
+    bounds: [number, number, number, number];
+    valid_pixel_count: number;
+    channel_std: RGB;
+    alpha_threshold: 128;
+    rounding: "MATH_ROUND_PER_CHANNEL";
+    [field: string]: unknown;
+  };
+  [field: string]: unknown;
+}
+
+export interface PreparedClarusColor {
+  color: string;
+  atlasClarus: ClarusAnnotation;
+}
