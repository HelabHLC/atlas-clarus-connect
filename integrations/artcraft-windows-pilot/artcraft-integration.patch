+import { useEffect, useState } from "react";
+import type { BoardColorItem } from "../boards/boardTypes";
+import type { ClarusAnnotation } from "./types";
+
+export function ClarusDetails({ item }: { item: BoardColorItem }) {
+  const raw = item.atlasClarus;
+  const [result, setResult] = useState<{
+    raw: unknown;
+    annotation?: ClarusAnnotation;
+    error?: string;
+  } | null>(null);
+  useEffect(() => {
+    let alive = true;
+    if (!raw) return;
+    void import("./importPalette")
+      .then(({ validateClarusAnnotation }) => validateClarusAnnotation(raw))
+      .then(
+        (annotation) => {
+          if (alive) setResult({ raw, annotation });
+        },
+        () => {
+          if (alive)
+            setResult({
+              raw,
+              error: "This saved ATLAS record could not be validated.",
+            });
+        },
+      );
+    return () => {
+      alive = false;
+    };
+  }, [raw]);
+
+  if (!raw) return null;
+  const current = result?.raw === raw ? result : null;
+  const annotation = current?.annotation;
+  if (!annotation) {
+    return (
+      <p role="status" className="text-xs text-base-fg/60">
+        {current?.error ?? "Checking ATLAS reference…"}
+      </p>
+    );
+  }
+  const source = annotation.source_assignment;
+  const changed = item.color.toUpperCase() !== source.source_hex;
+  return (
+    <section aria-label="ATLAS Clarus reference" className="space-y-3 text-xs">
+      <h3 className="font-semibold">ATLAS Clarus reference</h3>
+      {changed && (
+        <p role="status" className="text-amber-400">
+          The swatch has changed. This reference describes the imported original
+          color below.
+        </p>
+      )}
+      <dl className="space-y-2">
+        <div>
+          <dt className="text-base-fg/55">Original color (sRGB)</dt>
+          <dd>
+            {source.source_hex} · RGB {source.source_rgb.join(", ")}
+          </dd>
+        </div>
+        <div>
+          <dt className="text-base-fg/55">ATLAS address</dt>
+          <dd>{source.reference}</dd>
+        </div>
+        <div>
+          <dt className="text-base-fg/55">Reference row</dt>
+          <dd>{source.atlas_row_id} (zero-based)</dd>
+        </div>
+        <div>
+          <dt className="text-base-fg/55">Reference color</dt>
+          <dd className="flex items-center gap-2">
+            <span
+              className="inline-block h-4 w-4 rounded"
+              style={{ backgroundColor: source.reference_hex }}
+            />
+            {source.reference_hex}
+          </dd>
+        </div>
+        <div>
+          <dt className="text-base-fg/55">Recorded image</dt>
+          <dd className="break-words">
+            {source.image.name} · {source.image.width} × {source.image.height}
+          </dd>
+        </div>
+        <div>
+          <dt className="text-base-fg/55">Sample position</dt>
+          <dd>{source.sampling.centre.join(", ")}</dd>
+        </div>
+      </dl>
+      <p className="text-base-fg/60">
+        Reference checked against the pinned RGB table. Image origin and
+        signature are unverified.
+      </p>
+      <details>
+        <summary className="cursor-pointer">
+          Master checksum and recorded provenance
+        </summary>
+        <p className="mt-2 break-all font-mono">{source.master_sha256}</p>
+        <pre className="mt-2 whitespace-pre-wrap break-all text-[10px]">
+          {JSON.stringify(annotation, null, 2)}
+        </pre>
+      </details>
+    </section>
+  );
+}
diff --git a/frontend/libs/components/moodboard/src/lib/clarus/ClarusImportButton.tsx b/frontend/libs/components/moodboard/src/lib/clarus/ClarusImportButton.tsx
