index 0000000000000000000000000000000000000000..757670d877bd881ade11553eb532ef13c81f4d00
--- /dev/null
+++ b/frontend/libs/components/moodboard/src/lib/clarus/importPalette.ts
@@ -0,0 +1,373 @@
+import referenceCsv from "./reference-rgb.csv?raw";
+import type {
+  ClarusAnnotation,
+  ClarusPalette,
+  ClarusSourceAssignment,
+  PreparedClarusColor,
+  RGB,
+} from "./types";
+
+export const CLARUS_MASTER_SHA256 =
+  "8283ab91b10f89ac758d09ecf5fb4d6343536600a06dd468b1cc1ecf4ec747c4";
+export const CLARUS_RGB_SHA256 =
+  "a25f4dbd94d819ed3c9b899d0e0db7d4d9449cf8028201d0776fad93b5a7fab9";
+export const CLARUS_MAX_BYTES = 16 * 1024 * 1024;
+const WORKFLOW = "ATLAS Clarus v3.4.0";
+const encoder = new TextEncoder();
+
+interface ReferenceRow {
+  id: number;
+  reference: string;
+  rgb: RGB;
+  hex: string;
+}
+
+let tablePromise: Promise<ReferenceRow[]> | undefined;
+
+// No network or master writes. All entries validate before any board mutation.
+// Reference-only exports cannot recover original RGB and are rejected here.
+export async function prepareClarusImport(
+  input: Uint8Array,
+  filename: string,
+): Promise<PreparedClarusColor[]> {
+  requireValue(input.byteLength <= CLARUS_MAX_BYTES, "File exceeds 16 MiB.");
+  const bytes = new Uint8Array(input);
+  const palette = await validateClarusPalette(parseJson(bytes));
+  const documentSha256 = await sha256(bytes);
+  const documentId = crypto.randomUUID();
+  return palette.source_assignments.map((record, index) => ({
+    color: record.source_hex,
+    atlasClarus: {
+      schema: "atlas-clarus-artcraft/0.2",
+      role: "ORIGINAL_SOURCE",
+      import: {
+        document_id: documentId,
+        filename: filename.slice(0, 1024),
+        format: palette.format,
+        version: palette.version,
+        ...(palette.palette_name === undefined
+          ? {}
+          : { palette_name: palette.palette_name }),
+        document_sha256: documentSha256,
+        source_assignment_index: index,
+      },
+      // Clone the full received records, including additional provenance fields.
+      source_assignment: structuredClone(record),
+      reference_record: structuredClone(
+        palette.references.find(
+          (reference) => reference.atlas_row_id === record.atlas_row_id,
+        )!,
+      ),
+      reference_csv_sha256: CLARUS_RGB_SHA256,
+    },
+  }));
+}
+
+export async function validateClarusPalette(
+  value: unknown,
+): Promise<ClarusPalette> {
+  requireValue(isObject(value), "Expected a Clarus palette object.");
+  // This assertion gives validation code field types; every supported field
+  // is checked below before the value can leave this boundary.
+  const palette = value as unknown as ClarusPalette;
+  requireValue(
+    palette.format === "ATLAS_CLARUS_PALETTE" && palette.version === "1.2",
+    "Choose a Clarus palette JSON 1.2 file with recorded original colors.",
+  );
+  requireValue(
+    palette.master_sha256 === CLARUS_MASTER_SHA256 &&
+      palette.row_id_base === 0 &&
+      palette.freeze_status === "FROZEN" &&
+      palette.measured_qc_status === "NOT_MEASURED",
+    "Unsupported master binding or reference status.",
+  );
+  requireValue(
+    palette.workflow === WORKFLOW &&
+      (palette.palette_name === undefined ||
+        typeof palette.palette_name === "string"),
+    "Unsupported workflow or palette name.",
+  );
+  requireValue(
+    Array.isArray(palette.references) &&
+      palette.references.length > 0 &&
+      palette.references.length <= 64,
+    "Expected 1–64 reference records.",
+  );
+  const rows = await referenceTable();
+  const ids = new Set<number>();
+  for (const reference of palette.references) {
+    requireValue(isObject(reference), "Invalid reference record.");
+    const row = Number.isInteger(reference.atlas_row_id)
+      ? rows[reference.atlas_row_id]
+      : undefined;
+    requireValue(
+      row &&
+        !ids.has(row.id) &&
+        reference.reference === row.reference &&
+        same(reference.master_rgb, row.rgb) &&
+        typeof reference.master_hex === "string" &&
+        reference.master_hex.toUpperCase() === row.hex,
+      "Reference identity does not match the pinned RGB table.",
+    );
+    ids.add(row.id);
+  }
+  requireValue(
+    Array.isArray(palette.source_assignments) &&
+      palette.source_assignments.length > 0,
+    "No original colors recorded. Reference colors cannot be imported as originals.",
+  );
+  requireValue(
+    palette.source_assignments.length <= 4096,
+    "At most 4096 original color records are supported.",
+  );
+  const nearestCache = new Map<string, { id: number; distance: number }>();
+  for (const record of palette.source_assignments) {
+    requireValue(
+      isObject(record) &&
+        record.schema_version === "1.0" &&
+        isRgb(record.source_rgb) &&
+        record.source_hex === toHex(record.source_rgb),
+      "Original RGB and HEX must agree.",
+    );
+    requireValue(
+      record.color_space === "sRGB" &&
+        record.bits_per_channel === 8 &&
+        record.source_representation === "BROWSER_DECODED_SRGB",
+      "Expected browser-decoded 8-bit sRGB.",
+    );
+    const row = Number.isInteger(record.atlas_row_id)
+      ? rows[record.atlas_row_id]
+      : undefined;
+    requireValue(
+      row &&
+        ids.has(row.id) &&
+        record.reference === row.reference &&
+        same(record.reference_rgb, row.rgb) &&
+        record.reference_hex === row.hex &&
+        record.master_sha256 === CLARUS_MASTER_SHA256,
+      "Source assignment has a conflicting reference identity.",
+    );
+    requireValue(
+      record.workflow === WORKFLOW &&
+        record.metric === "RGB_SQUARED_DISTANCE" &&
+        record.tie_break === "LOWER_ATLAS_ROW_ID" &&
+        record.signature_status === "NOT_SIGNED",
+      "Unsupported assignment method or signature claim.",
+    );
+    let best = nearestCache.get(record.source_hex);
+    if (!best) {
+      best = { id: 0, distance: Infinity };
+      // Rows are ascending; equal distances retain the lower row id.
+      for (const candidate of rows) {
+        const distance = squaredDistance(record.source_rgb, candidate.rgb);
+        if (distance < best.distance) best = { id: candidate.id, distance };
+      }
+      nearestCache.set(record.source_hex, best);
+    }
+    requireValue(
+      record.atlas_row_id === best.id &&
+        record.distance_squared === best.distance,
+      "Assignment is not the nearest reference under the recorded RGB rule.",
+    );
+    validateSampling(record);
+  }
+  return palette;
+}
+
+// Recheck saved annotations before displaying any mapping as valid. A board
+// document or localStorage value is not proof that an import was validated.
+export async function validateClarusAnnotation(
+  value: unknown,
+): Promise<ClarusAnnotation> {
+  requireValue(isObject(value), "Missing ATLAS record.");
+  const annotation = value as unknown as ClarusAnnotation;
+  const origin = annotation.import;
+  requireValue(
+    annotation.schema === "atlas-clarus-artcraft/0.2" &&
+      annotation.role === "ORIGINAL_SOURCE" &&
+      annotation.reference_csv_sha256 === CLARUS_RGB_SHA256 &&
+      isObject(origin) &&
+      typeof origin.document_id === "string" &&
+      typeof origin.filename === "string" &&
+      origin.filename.length <= 1024 &&
+      isHash(origin.document_sha256) &&
+      Number.isInteger(origin.source_assignment_index) &&
+      origin.source_assignment_index >= 0,
+    "Unsupported or incomplete saved ATLAS record.",
+  );
+  await validateClarusPalette({
+    format: origin.format,
+    version: origin.version,
+    palette_name: origin.palette_name,
+    workflow: WORKFLOW,
+    master_sha256: CLARUS_MASTER_SHA256,
+    row_id_base: 0,
+    freeze_status: "FROZEN",
+    measured_qc_status: "NOT_MEASURED",
+    references: [annotation.reference_record],
+    source_assignments: [annotation.source_assignment],
+  });
+  return annotation;
+}
+
+async function referenceTable(): Promise<ReferenceRow[]> {
+  if (!tablePromise) {
+    tablePromise = (async () => {
+      requireValue(
+        (await sha256(encoder.encode(referenceCsv))) === CLARUS_RGB_SHA256,
+        "Pinned RGB table checksum failed.",
+      );
+      const lines = referenceCsv.trimEnd().split("\n");
+      requireValue(
+        lines.shift() === "atlas_row_id,reference,R,G,B,hex" &&
+          lines.length === 13283,
+        "Invalid RGB reference table.",
+      );
+      return lines.map((line, index) => {
+        const [id, reference, r, g, b, hex] = line.split(",");
+        const rgb: RGB = [Number(r), Number(g), Number(b)];
+        requireValue(
+          Number(id) === index && isRgb(rgb) && toHex(rgb) === hex,
+          "Invalid RGB reference row.",
+        );
+        return { id: index, reference, rgb, hex };
+      });
+    })().catch((error: unknown) => {
+      tablePromise = undefined;
+      throw error;
+    });
+  }
+  return tablePromise;
+}
+
+function validateSampling(record: ClarusSourceAssignment): void {
+  const image = record.image;
+  const sampling = record.sampling;
+  requireValue(
+    isObject(image) &&
+      typeof image.name === "string" &&
+      image.name.length > 0 &&
+      image.name.length <= 1024 &&
+      Number.isSafeInteger(image.width) &&
+      image.width > 0 &&
+      Number.isSafeInteger(image.height) &&
+      image.height > 0 &&
+      (image.sha256 === null || isHash(image.sha256)),
+    "Invalid recorded image metadata.",
+  );
+  requireValue(
+    isObject(sampling) &&
+      [1, 5, 11, 21].includes(sampling.requested_size) &&
+      sampling.mode ===
+        (sampling.requested_size === 1 ? "PIXEL_RGB" : "AREA_MEAN_RGB") &&
+      sampling.alpha_threshold === 128 &&
+      sampling.rounding === "MATH_ROUND_PER_CHANNEL" &&
+      Array.isArray(sampling.centre) &&
+      sampling.centre.length === 2 &&
+      sampling.centre.every(Number.isSafeInteger) &&
+      sampling.centre[0] >= 0 &&
+      sampling.centre[0] < image.width &&
+      sampling.centre[1] >= 0 &&
+      sampling.centre[1] < image.height,
+    "Invalid sampling method or position.",
+  );
+  const half = (sampling.requested_size - 1) / 2;
+  const [x, y] = sampling.centre;
+  const bounds = [
+    Math.max(0, x - half),
+    Math.max(0, y - half),
+    Math.min(image.width - 1, x + half),
+    Math.min(image.height - 1, y + half),
+  ];
+  requireValue(
+    same(sampling.bounds, bounds) &&
+      Number.isInteger(sampling.valid_pixel_count) &&
+      sampling.valid_pixel_count > 0 &&
+      sampling.valid_pixel_count <=
+        (bounds[2] - bounds[0] + 1) * (bounds[3] - bounds[1] + 1) &&
+      Array.isArray(sampling.channel_std) &&
+      sampling.channel_std.length === 3 &&
+      sampling.channel_std.every(
+        (value) =>
+          Number.isFinite(value) && value >= 0 && value <= 127.500000001,
+      ) &&
+      (sampling.valid_pixel_count !== 1 ||
+        sampling.channel_std.every((value) => value === 0)),
+    "Invalid sampling bounds, pixel count or spread.",
+  );
+}
+
+function parseJson(bytes: Uint8Array): unknown {
+  let value: unknown;
+  try {
+    value = JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(bytes));
+  } catch {
+    throw new Error("Choose a valid UTF-8 JSON file.");
+  }
+  const queue: [unknown, number][] = [[value, 0]];
+  while (queue.length) {
+    const [entry, depth] = queue.pop()!;
+    requireValue(depth <= 64, "JSON nesting exceeds 64 levels.");
+    if (typeof entry === "number")
+      requireValue(Number.isFinite(entry), "Non-finite JSON number.");
+    if (entry !== null && typeof entry === "object") {
+      for (const child of Object.values(entry)) queue.push([child, depth + 1]);
+    }
+  }
+  return value;
+}
+
+async function sha256(bytes: Uint8Array): Promise<string> {
+  requireValue(
+    globalThis.crypto?.subtle,
+    "SHA-256 is unavailable in this application context.",
+  );
+  const digest = await crypto.subtle.digest("SHA-256", bytes);
+  return Array.from(new Uint8Array(digest), (value) =>
+    value.toString(16).padStart(2, "0"),
+  ).join("");
+}
+
+function requireValue(value: unknown, message: string): asserts value {
+  if (!value) throw new Error(message);
+}
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+function same(value: unknown, expected: number[]): boolean {
+  return (
+    Array.isArray(value) &&
+    value.length === expected.length &&
+    expected.every((channel, index) => value[index] === channel)
+  );
+}
+
+function isRgb(value: unknown): value is RGB {
+  return (
+    Array.isArray(value) &&
+    value.length === 3 &&
+    value.every(
+      (channel) => Number.isInteger(channel) && channel >= 0 && channel <= 255,
+    )
+  );
+}
+
+function toHex(rgb: RGB): string {
+  return (
+    "#" +
+    rgb
+      .map((value) => value.toString(16).padStart(2, "0"))
+      .join("")
+      .toUpperCase()
+  );
+}
+
+function isHash(value: unknown): boolean {
+  return typeof value === "string" && /^[0-9a-f]{64}$/.test(value);
+}
+
+function squaredDistance(a: RGB, b: RGB): number {
+  return (a[0] - b[0]) ** 2 + (a[1] - b[1]) ** 2 + (a[2] - b[2]) ** 2;
+}
