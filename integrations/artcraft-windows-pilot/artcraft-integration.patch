index 0000000000000000000000000000000000000000..2516106a562fce68ad396dcf23202666bedbc990
--- /dev/null
+++ b/frontend/libs/components/moodboard/src/lib/clarus/ClarusImportButton.tsx
@@ -0,0 +1,108 @@
+import { useRef, useState } from "react";
+import { FileInputIcon, FileOutputIcon } from "lucide-react";
+import toast from "react-hot-toast";
+import { useBoardLibraryStore } from "../boards/BoardLibraryStore";
+import { ToolbarIconButton } from "../ui/Toolbar";
+
+export function ClarusImportButton({ boardId }: { boardId: string | null }) {
+  const input = useRef<HTMLInputElement>(null);
+  const busyRef = useRef(false);
+  const [busy, setBusy] = useState(false);
+  const importPalette = useBoardLibraryStore(
+    (state) => state.importClarusPalette,
+  );
+  const board = useBoardLibraryStore((state) =>
+    boardId ? state.boards[boardId] : undefined,
+  );
+  const hasClarus =
+    board?.itemOrder.some((id) => {
+      const item = board.items[id];
+      return item?.kind === "color" && Boolean(item.atlasClarus);
+    }) ?? false;
+
+  const readFile = async (file: File) => {
+    if (!boardId || busyRef.current) return;
+    busyRef.current = true;
+    setBusy(true);
+    try {
+      if (file.size > 16 * 1024 * 1024) throw new Error("File exceeds 16 MiB.");
+      const count = await importPalette(
+        boardId,
+        new Uint8Array(await file.arrayBuffer()),
+        file.name,
+      );
+      toast.success("Imported " + count + " original colors with ATLAS references");
+    } catch (error) {
+      toast.error(
+        error instanceof Error ? error.message : "Clarus import failed.",
+      );
+    } finally {
+      busyRef.current = false;
+      setBusy(false);
+    }
+  };
+
+  const exportFile = async () => {
+    if (!board || busyRef.current) return;
+    busyRef.current = true;
+    setBusy(true);
+    try {
+      const { createClarusExport } = await import("./exportPalette");
+      const result = await createClarusExport(board);
+      downloadJson(result.text, result.filename);
+      toast.success(
+        "Exported " + result.sourceCount + " original colors as Clarus JSON 1.2",
+      );
+    } catch (error) {
+      toast.error(
+        error instanceof Error ? error.message : "Clarus export failed.",
+      );
+    } finally {
+      busyRef.current = false;
+      setBusy(false);
+    }
+  };
+
+  return (
+    <>
+      <ToolbarIconButton
+        icon={FileInputIcon}
+        label={busy ? "ATLAS Clarus operation in progress…" : "Import ATLAS Clarus palette"}
+        disabled={busy || !boardId}
+        onClick={() => input.current?.click()}
+      />
+      <ToolbarIconButton
+        icon={FileOutputIcon}
+        label={busy ? "ATLAS Clarus operation in progress…" : "Export ATLAS Clarus palette"}
+        disabled={busy || !hasClarus}
+        onClick={() => void exportFile()}
+      />
+      <input
+        ref={input}
+        type="file"
+        accept=".json,application/json"
+        aria-label="ATLAS Clarus palette JSON"
+        hidden
+        onChange={(event) => {
+          const file = event.currentTarget.files?.[0];
+          event.currentTarget.value = "";
+          if (file) void readFile(file);
+        }}
+      />
+    </>
+  );
+}
+
+function downloadJson(text: string, filename: string) {
+  const url = URL.createObjectURL(
+    new Blob([text], { type: "application/json;charset=utf-8" }),
+  );
+  const link = document.createElement("a");
+  link.href = url;
+  link.download = filename;
+  link.style.display = "none";
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+  window.setTimeout(() => URL.revokeObjectURL(url), 1000);
+}

