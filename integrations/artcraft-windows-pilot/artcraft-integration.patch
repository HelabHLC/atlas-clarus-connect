+import { webcrypto } from "node:crypto";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import sourceText from "./two-greens.clarus.json?raw";
+import { useBoardLibraryStore } from "../boards/BoardLibraryStore";
+import { createClarusExport } from "./exportPalette";
+import type { ClarusPalette } from "./types";
+
+const fixture = (): ClarusPalette => JSON.parse(sourceText);
+
+beforeEach(() => {
+  vi.stubGlobal("crypto", webcrypto);
+  localStorage.clear();
+  useBoardLibraryStore.setState({
+    boards: {},
+    boardOrder: [],
+    activeBoardId: null,
+    selectedItemIds: new Set(),
+  });
+});
+afterEach(() => {
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+});
+
+describe("Clarus export from native ArtCraft boards", () => {
+  it("reconstructs a valid Clarus 1.2 palette without remapping", async () => {
+    const store = useBoardLibraryStore.getState();
+    const id = store.createBoard("Round trip");
+    await store.importClarusPalette(
+      id,
+      new TextEncoder().encode(sourceText),
+      "greens.json",
+    );
+    const result = await createClarusExport(
+      useBoardLibraryStore.getState().boards[id],
+    );
+    const parsed = JSON.parse(result.text) as ClarusPalette;
+    expect(parsed.master_sha256).toBe(fixture().master_sha256);
+    expect(parsed.freeze_status).toBe("FROZEN");
+    expect(parsed.measured_qc_status).toBe("NOT_MEASURED");
+    expect(parsed.references).toEqual(fixture().references);
+    expect(parsed.source_assignments).toEqual(fixture().source_assignments);
+    expect(result.sourceCount).toBe(2);
+    expect(result.filename.endsWith(".clarus.json")).toBe(true);
+  });
+
+  it("exports the recorded original even if the design swatch was edited", async () => {
+    const store = useBoardLibraryStore.getState();
+    const id = store.createBoard("Edited");
+    await store.importClarusPalette(
+      id,
+      new TextEncoder().encode(sourceText),
+      "greens.json",
+    );
+    const board = useBoardLibraryStore.getState().boards[id];
+    const first = board.itemOrder[0];
+    store.updateItem(id, first, { color: "#FFFFFF" });
+    const result = await createClarusExport(
+      useBoardLibraryStore.getState().boards[id],
+    );
+    expect(result.palette.source_assignments[0].source_hex).toBe("#3D7B19");
+    expect(result.palette.source_assignments[0].reference_hex).toBe("#37791A");
+  });
+
+  it("does not invent source provenance for ordinary ArtCraft swatches", async () => {
+    const store = useBoardLibraryStore.getState();
+    const id = store.createBoard("Legacy");
+    store.addColorItem(id, "#123456");
+    await expect(
+      createClarusExport(useBoardLibraryStore.getState().boards[id]),
+    ).rejects.toThrow("no imported ATLAS Clarus original colors");
+  });
+});
